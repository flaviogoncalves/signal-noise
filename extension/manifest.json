{
  "manifest_version": 3,
  "name": "Signal / Noise",
  "version": "0.4.0",
  "description": "Tells you whether a YouTube video is worth your time: what is new in it, what it changes, and which chapters to skip.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Signal / Noise"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "js/extension/background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.sippulse.ai/*"]
}
